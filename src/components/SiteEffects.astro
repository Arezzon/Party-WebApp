---
import Grainient from './Grainient';
import Lightning from './Lightning';
import Noise from './Noise';
---

<!-- React Bits: новий shader-фон Grainient + блискавки + плівкове зерно. Шари не ловлять кліки. -->
<div class="effects-glow pointer-events-none fixed inset-0 z-0 overflow-hidden" style="position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none;" aria-hidden="true">
  <div class="absolute inset-0">
    <Grainient
      client:load
      colors={['#0a0418', '#2b0a3d', '#7a104a', '#ff2e88', '#00e5ff']}
      type="radial"
      angle={42}
      bands={2}
      speed={0.42}
      flow={0.72}
      scale={1.1}
      softness={0.65}
      silk={0.78}
      grainAmount={0.14}
      grainSize={1.4}
      grainAnimated
      contrast={1.08}
      saturation={1.18}
      variation={0.42}
      interactive
      stir={0.55}
      clickSwirl
      intro
      dpr={1.5}
      style={{ opacity: 0.52 }}
    />
  </div>
  <div class="absolute right-0 top-0 h-[460px] w-[560px] opacity-60">
    <Lightning
      client:load
      color="#00e5ff"
      bolts={2}
      spread={0.55}
      branches={2}
      xOffset={0.72}
      angle={-0.18}
      size={0.7}
      thickness={1}
      glow={0.6}
      intensity={0.32}
      speed={0.35}
      flicker={0.28}
      mouseInteraction
      clickStrike
      intro
      opacity={0.4}
      dpr={1.5}
    />
  </div>
  <Noise
    client:load
    opacity={0.045}
    size={140}
    fps={12}
    contrast={130}
    dust={0.35}
    scratches={0}
    scanlines={0.12}
    flicker={0.12}
    fixed
    zIndex={0}
  />
</div>
