---
const year = new Date().getFullYear();
---

<footer class="relative z-10 mx-auto w-full max-w-[1100px] px-5 pb-12 sm:px-10">
  <div class="hairline"></div>
  <div class="flex flex-wrap items-center justify-between gap-6 py-8">
    <a href="/" class="display text-xl" aria-label="Тусовка — на головну">тусовка<span class="serif text-[1.1em]">.</span></a>
    <nav aria-label="Додатково" class="flex flex-wrap items-center gap-5 text-sm text-muted-foreground">
      <a href="/" class="transition-colors hover:text-foreground">Події</a>
      <a href="/rules" class="transition-colors hover:text-foreground">Правила</a>
      <a href="/privacy" class="transition-colors hover:text-foreground">Конфіденційність</a>
    </nav>
  </div>
  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border pt-5">
    <p class="eyebrow">Час подій — за Києвом</p>
    <p class="eyebrow">© {year} · Тусовка</p>
  </div>
</footer>
