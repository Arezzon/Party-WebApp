---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import AuthForm from '../components/site/AuthForm';
import { registerSchema, formatZodError } from '../lib/validation.ts';
import { registerUser, getUserById } from '../lib/auth.ts';

let error = '';

if (Astro.request.method === 'POST') {
  let email = '';
  let password = '';
  let name = '';
  let key = '';
  try {
    const form = await Astro.request.formData();
    email = String(form.get('email') ?? '');
    password = String(form.get('password') ?? '');
    name = String(form.get('name') ?? '');
    key = String(form.get('idempotencyKey') ?? Astro.request.headers.get('Idempotency-Key') ?? '');
  } catch {
    error = 'Некоректні дані форми.';
    Astro.response.status = 400;
  }

  if (!error) {
    const parsed = registerSchema.safeParse({ email, password, name });
    if (!parsed.success) {
      error = formatZodError(parsed.error);
      Astro.response.status = 400;
    } else {
      try {
        // Registration is idempotent by the UNIQUE(email) constraint; an
        // IdempotencyKey row cannot reference a user that does not exist yet.
        const user = await registerUser(parsed.data);
        if (!user) throw new Error('Не вдалося створити акаунт.');
        return Astro.redirect('/login?registered=1', 303);
      } catch (cause) {
        error = cause instanceof Error ? cause.message : 'Не вдалося зареєструватися.';
        Astro.response.status = 400;
      }
    }
  }
}
---

<Layout title="Реєстрація — Тусовка">
  <AuthForm
    client:load
    mode="register"
    error={error}
    notice={Astro.url.searchParams.get('registered') === '1' ? 'Акаунт створено. Увійдіть, будь ласка.' : ''}
  />
</Layout>
