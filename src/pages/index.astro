---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getDb } from '../lib/db';
import SiteHeading from '../components/site/SiteHeading';
import PromoStrip from '../components/site/PromoStrip';
import EventExplorer, { type EventItem } from '../components/site/EventExplorer';

const q = (Astro.url.searchParams.get('q') ?? '').trim();
const needle = q.toLocaleLowerCase('uk-UA');

const rawDb: any = getDb();
const db: any = rawDb?.db ?? rawDb;
const now = new Date().toISOString();

const rows = db
  .prepare(
    `SELECT e.id, e.title, e.starts_at, e.places,
            (SELECT COUNT(*) FROM RSVP r WHERE r.event_id = e.id) AS taken,
            (e.cover_blob IS NOT NULL) AS has_cover
       FROM Events e
      WHERE e.visibility = 'public' AND e.starts_at > ?
      ORDER BY e.starts_at ASC
      LIMIT 500`
  )
  .all(now) as Array<{
  id: string;
  title: string;
  starts_at: string;
  places: number;
  taken: number;
  has_cover: number;
}>;

const filtered = needle
  ? rows.filter((event) => String(event.title ?? '').toLocaleLowerCase('uk-UA').includes(needle))
  : rows;

const fmt = new Intl.DateTimeFormat('uk-UA', {
  timeZone: 'Europe/Kyiv',
  dateStyle: 'medium',
  timeStyle: 'short'
});

const events: EventItem[] = filtered.map((event) => ({
  id: event.id,
  title: event.title,
  date: fmt.format(new Date(event.starts_at)),
  free: Math.max(0, event.places - event.taken),
  cover: event.has_cover ? `/events/${event.id}/cover` : null
}));
---

<Layout title="Тусовка — події">
  <div class="flex flex-col gap-8">
    <SiteHeading
      client:load
      eyebrow="Vice City · нічне життя"
      title="Події після заходу"
      subtitle="Обирай своє. Час указано за Києвом."
    />

    {q ? (
      <p class="text-sm text-muted-foreground">
        Результати пошуку: <span class="vc-chip">«{q}»</span>
      </p>
    ) : (
      <PromoStrip client:load href="/events/new" />
    )}

    <EventExplorer client:load query={q} events={events} />
  </div>
</Layout>
