---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getDb } from '../lib/db';
import HeroText from '../components/bits/HeroText';
import GlitchLabel from '../components/GlitchLabel';
import PromoBanner from '../components/bits/PromoBanner';
import EventBrowser from '../components/bits/EventBrowser';

/**
 * Головна: майбутні публічні події + пошук за назвою ?q=.
 * Пошук регістронезалежний для кирилиці: SQLite LIKE/LOWER працюють лише з ASCII,
 * тому фільтрація відбувається в JS через toLocaleLowerCase('uk-UA').
 */
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const needle = q.toLocaleLowerCase('uk-UA');

const rawDb: any = getDb();
const db: any = rawDb?.db ?? rawDb;
const now = new Date().toISOString();
const rows = db
  .prepare(
    `SELECT e.id, e.title, e.description, e.starts_at, e.places,
            (SELECT COUNT(*) FROM RSVP r WHERE r.event_id = e.id) AS taken,
            (e.cover_blob IS NOT NULL) AS has_cover
       FROM Events e
      WHERE e.visibility = 'public' AND e.starts_at > ?
      ORDER BY e.starts_at ASC
      LIMIT 500`
  )
  .all(now) as Array<{
  id: string;
  title: string;
  description: string | null;
  starts_at: string;
  places: number;
  taken: number;
  has_cover: number;
}>;

const events = needle
  ? rows.filter((event) => String(event.title ?? '').toLocaleLowerCase('uk-UA').includes(needle))
  : rows;

const fmt = new Intl.DateTimeFormat('uk-UA', {
  timeZone: 'Europe/Kyiv',
  dateStyle: 'medium',
  timeStyle: 'short'
});

const eventItems = events.map((event) => ({
  id: event.id,
  title: event.title,
  description: event.description ? String(event.description).slice(0, 90) : 'Подія без опису',
  date: fmt.format(new Date(event.starts_at)),
  free: Math.max(0, event.places - event.taken),
  cover: event.has_cover ? `/events/${event.id}/cover` : null
}));
---

<Layout title="Тусовка — події">
  <div class="flex flex-col gap-6">
    <HeroText
      client:load
      title="Події після заходу"
      subtitle="Час указано за Києвом."
      eyebrow="Vice City · нічне життя"
    />

    {q ? (
      <p class="text-sm text-muted-foreground">
        Результати пошуку: <GlitchLabel client:load text={`«${q}»`} />
      </p>
    ) : (
      <PromoBanner client:load href="/events/new" />
    )}

    {eventItems.length === 0 ? (
      <p class="rounded-lg border border-dashed border-border p-8 text-center text-muted-foreground">
        Подій поки немає. Створіть першу!
      </p>
    ) : (
      <EventBrowser client:load query={q} events={eventItems} />
    )}
  </div>
</Layout>
