---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import EventForm from '../../../components/site/EventForm';
import SpecularButton from '../../../components/SpecularButton';
import SiteHeading from '../../../components/site/SiteHeading';
import { requireUser } from '../../../lib/auth.ts';
import { getAttendees, getEvent, toKyivInput } from '../../../lib/events.ts';
import { maxEventDateInput } from '../../../lib/timezone.ts';

const user = requireUser(Astro);
if (!user) {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`, 302);
}

const id = Astro.params.id ?? '';
const event = getEvent(id);
if (!event) {
  return new Response('Подію не знайдено.', { status: 404 });
}
if (event.authorId !== user.id) {
  return new Response('Редагувати подію може лише автор.', { status: 403 });
}

const attendees = getAttendees(id);
const initial = {
  id: event.id,
  title: event.title,
  description: event.description,
  startsAt: toKyivInput(event.startsAt),
  places: event.places,
  visibility: event.visibility,
  coverUrl: `/events/${event.id}/cover`
};
---

<Layout title={`Редагування: ${event.title} — Тусовка`}>
  <div class="flex flex-col gap-8">
    <SiteHeading client:load eyebrow="Контрольна кімната" title="Редагувати подію" subtitle="Тримай місто в тонусі." />

    <EventForm client:load action={`/api/events/${event.id}/edit`} initial={initial} maxDate={maxEventDateInput()} />

    <section class="vc-panel p-6">
      <h2 class="mb-3 text-lg font-semibold">Учасники · {attendees.length}</h2>
      {
        attendees.length === 0 ? (
          <p class="text-sm text-muted-foreground">Поки ніхто не записався.</p>
        ) : (
          <ul class="flex flex-col gap-2 text-sm">
            {attendees.map((person) => (
              <li class="flex items-center justify-between gap-3 rounded-lg bg-secondary/60 px-3 py-2">
                <span class="font-medium">{person.name}</span>
                <span class="text-muted-foreground">{person.email}</span>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="vc-panel flex flex-wrap items-center justify-between gap-4 p-6">
      <p class="text-sm text-muted-foreground">Видалення незворотнє.</p>
      <form method="post" action={`/api/events/${event.id}/delete`}>
        <SpecularButton client:load type="submit" size="sm" tint="#ff3d5f" textColor="#07020f">
          Видалити подію
        </SpecularButton>
      </form>
    </section>
  </div>
</Layout>
