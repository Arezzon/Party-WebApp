---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { requireUser } from '../../../lib/auth.ts';
import { getDb } from '../../../lib/db.ts';
import { canViewEventFromRequest, getAttendees, getEvent, rsvpCount } from '../../../lib/events.ts';
import { formatKyiv } from '../../../lib/timezone.ts';
import EventDetailBits from '../../../components/bits/EventDetailBits';

const id = Astro.params.id ?? '';
const event = getEvent(id);
if (!event || !canViewEventFromRequest(event, Astro.cookies, Astro.url)) {
  return new Response('Подію не знайдено.', {
    status: 404,
    headers: { 'Content-Type': 'text/plain; charset=utf-8', 'X-Content-Type-Options': 'nosniff' }
  });
}

const user = requireUser(Astro);
const isAuthor = Boolean(user && user.id === event.authorId);
const attendees = getAttendees(id);
const left = Math.max(0, event.places - rsvpCount(id));

let going = false;
if (user) {
  going = Boolean(
    getDb().prepare('SELECT 1 FROM RSVP WHERE event_id = ? AND user_id = ?').get(id, user.id)
  );
}
const idempotencyKey = typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function'
  ? crypto.randomUUID()
  : `${Date.now()}`;
---

<Layout title={`${event.title} — Тусовка`}>
  <EventDetailBits
    client:load
    id={event.id}
    title={event.title}
    date={formatKyiv(event.startsAt)}
    description={event.description ?? ''}
    left={left}
    places={event.places}
    isPrivate={event.visibility === 'private'}
    cover={`/events/${event.id}/cover`}
    user={Boolean(user)}
    isAuthor={isAuthor}
    going={going}
    idempotencyKey={idempotencyKey}
    attendees={attendees.map((person: { name: string }) => String(person.name))}
  />
</Layout>
