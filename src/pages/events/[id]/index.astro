---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import EventDetail from '../../../components/site/EventDetail.astro';
import { requireUser } from '../../../lib/auth.ts';
import { getDb } from '../../../lib/db.ts';
import { canViewEventFromRequest, getAttendees, getEvent, rsvpCount } from '../../../lib/events.ts';
import { formatKyiv } from '../../../lib/timezone.ts';

const id = Astro.params.id ?? '';
const db = await getDb();
const event = await getEvent(id);
if (!event || !canViewEventFromRequest(event, Astro.cookies, Astro.url)) {
  return new Response('Подію не знайдено.', { status: 404 });
}

const user = await requireUser(Astro);
const isAuthor = Boolean(user && user.id === event.authorId);
const left = Math.max(0, event.places - (await rsvpCount(id)));

let going = false;
if (user) {
  going = Boolean(await db.prepare('SELECT 1 FROM RSVP WHERE event_id = ? AND user_id = ?').get(id, user.id));
}

const commentRows = (await db
  .prepare('SELECT id, body, author_id, author_name_snapshot, created_at FROM comments WHERE event_id = ? ORDER BY created_at ASC, id ASC')
  .all(id) ?? []) as Array<{ id: string; body: string; author_id: string | null; author_name_snapshot: string; created_at: string }>;
const comments = commentRows.map((row) => ({
  id: String(row.id),
  body: String(row.body ?? ''),
  authorId: String(row.author_id ?? ''),
  author: String(row.author_name_snapshot || 'Знайомець'),
  createdAt: formatKyiv(row.created_at)
}));

const idempotencyKey = typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function'
  ? crypto.randomUUID()
  : `${Date.now()}`;
const attendees = (await getAttendees(id)).map((person: { name: string }) => String(person.name));
---

<Layout title={`${event.title} — Тусовка`}>
  <EventDetail
    id={event.id}
    title={event.title}
    date={formatKyiv(event.startsAt)}
    description={event.description ?? ''}
    left={left}
    places={event.places}
    isPrivate={event.visibility === 'private'}
    cover={`/events/${event.id}/cover`}
    user={Boolean(user)}
    isAuthor={isAuthor}
    going={going}
    idempotencyKey={idempotencyKey}
    attendees={attendees}
    comments={comments}
    userId={user ? String(user.id) : ''}
  />
</Layout>
