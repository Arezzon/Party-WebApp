---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import EventForm from '../../components/site/EventForm';
import { requireUser } from '../../lib/auth.ts';
import { maxEventDateInput } from '../../lib/timezone.ts';

const user = await requireUser(Astro);
if (!user) {
  return Astro.redirect('/login?next=/events/new', 302);
}
---

<Layout title="Нова подія — Тусовка">
  <EventForm client:load action="/api/events" maxDate={maxEventDateInput()} />
</Layout>
