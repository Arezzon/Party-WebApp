---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import AuthForm from '../components/site/AuthForm';
import { loginSchema } from '../lib/validation.ts';
import {
  authenticateUser,
  clearLoginFailures,
  clientKey,
  createSession,
  recordFailedLogin,
  setSessionCookie
} from '../lib/auth.ts';

let error = '';
let email = '';

if (Astro.request.method === 'POST') {
  let password = '';
  let next = '';
  try {
    const form = await Astro.request.formData();
    email = String(form.get('email') ?? '');
    password = String(form.get('password') ?? '');
    next = String(form.get('next') ?? '');
  } catch {
    error = 'Некоректні дані форми.';
    Astro.response.status = 400;
  }

  if (!error) {
    const limitKey = `login:${clientKey(Astro.request)}`;
    const parsed = loginSchema.safeParse({ email, password });
    const user = parsed.success ? await authenticateUser(parsed.data.email, password) : null;
    if (!user) {
      await recordFailedLogin(limitKey);
      error = 'Невірний email або пароль.';
      Astro.response.status = 400;
    } else {
      await clearLoginFailures(limitKey);
      const session = await createSession(user.id);
      setSessionCookie(Astro.cookies, session.token);
      const destination = next.startsWith('/') && !next.startsWith('//') ? next : '/';
      return Astro.redirect(destination, 303);
    }
  }
}
---

<Layout title="Вхід — Тусовка">
  <AuthForm
    client:load
    mode="login"
    error={error}
    next={String(Astro.url.searchParams.get('next') ?? '')}
    notice={Astro.url.searchParams.get('registered') === '1' ? 'Акаунт створено. Увійдіть, будь ласка.' : ''}
  />
</Layout>
