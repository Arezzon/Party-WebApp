---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import ProfilePanel from '../components/site/ProfilePanel';
import { currentUser, database } from './invite/_check';

const user = await currentUser(Astro as any);
if (!user) return Astro.redirect('/login', 302);

const db = await database();
const created = (db.prepare(
  'SELECT id, title, starts_at, places, visibility FROM events WHERE author_id = ? ORDER BY starts_at DESC'
).all(user.id) ?? []) as any[];
const attending = (db.prepare(
  'SELECT e.id, e.title, e.starts_at, e.places FROM rsvp r JOIN events e ON e.id = r.event_id WHERE r.user_id = ? ORDER BY e.starts_at DESC'
).all(user.id) ?? []) as any[];

const formatKyiv = (value: unknown): string => {
  if (!value) return '';
  const date = new Date(String(value));
  if (Number.isNaN(date.getTime())) return String(value);
  return new Intl.DateTimeFormat('uk-UA', {
    timeZone: 'Europe/Kyiv', dateStyle: 'medium', timeStyle: 'short'
  }).format(date) + ' (за Києвом)';
};

const userName = String(user.name ?? '');
---

<Layout title="Профіль — Тусовка">
  <div class="flex flex-col gap-12">
    <header>
      <p class="eyebrow">Особиста справа</p>
      <h1 class="display mt-4 text-4xl sm:text-5xl">Мій профіль</h1>
      <p class="prose-calm mt-4">Тут ви керуєте своїми даними та подіями.</p>
    </header>
    <ProfilePanel
      client:load
      name={userName}
      created={created.map((event) => ({
        id: String(event.id),
        title: String(event.title),
        meta: `${formatKyiv(event.starts_at)} · ${event.places} місць`,
        private: event.visibility === 'private'
      }))}
      attending={attending.map((event) => ({
        id: String(event.id),
        title: String(event.title),
        meta: formatKyiv(event.starts_at)
      }))}
    />
  </div>
</Layout>
