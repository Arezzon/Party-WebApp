---
export const prerender = false;
import SiteEffects from '../components/SiteEffects.astro';
import ProfileForm from '../components/ProfileForm';
import { currentUser, database } from './invite/_check';

const user = await currentUser(Astro as any);
if (!user) return Astro.redirect('/login', 302);

const db = await database();
const created = (db.prepare(
  'SELECT id, title, starts_at, places, visibility FROM events WHERE author_id = ? ORDER BY starts_at DESC'
).all(user.id) ?? []) as any[];
const attending = (db.prepare(
  'SELECT e.id, e.title, e.starts_at, e.places FROM rsvp r JOIN events e ON e.id = r.event_id WHERE r.user_id = ? ORDER BY e.starts_at DESC'
).all(user.id) ?? []) as any[];

const escapeHtml = (value: unknown): string =>
  String(value ?? '').replace(/[&<>"']/g, (char) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  } as Record<string, string>)[char] ?? char);

const formatKyiv = (value: unknown): string => {
  if (!value) return '';
  const date = new Date(String(value));
  if (Number.isNaN(date.getTime())) return String(value);
  return new Intl.DateTimeFormat('uk-UA', {
    timeZone: 'Europe/Kyiv', dateStyle: 'medium', timeStyle: 'short'
  }).format(date) + ' (за Києвом)';
};

const userName = String(user.name ?? '');
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>Профіль — Тусовка</title>
    <style>
      :root { color-scheme: dark; }
      body { margin: 0; background: #0b0d12; color: #e6e8ee; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; line-height: 1.5; }
      main { max-width: 820px; margin: 0 auto; padding: 32px 20px 64px; }
      h1 { font-size: 1.9rem; letter-spacing: -0.02em; margin: 0 0 8px; }
      h2 { font-size: 1.25rem; margin: 32px 0 12px; }
      p.lead { color: #9aa2b1; margin: 0 0 24px; }
      ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
      li { border: 1px solid #262b36; border-radius: 12px; padding: 14px 16px; background: #12151d; overflow-wrap: anywhere; }
      li a { color: #8ab4ff; text-decoration: none; }
      li a:hover { text-decoration: underline; }
      .meta { color: #9aa2b1; font-size: 0.9rem; }
      .empty { color: #9aa2b1; border: 1px dashed #303643; border-radius: 12px; padding: 16px; }
      .badge { font-size: 0.75rem; color: #c9a7ff; border: 1px solid #443263; border-radius: 999px; padding: 2px 8px; margin-left: 8px; }
      nav { display: flex; gap: 16px; flex-wrap: wrap; }
      nav a { color: #9aa2b1; text-decoration: none; font-size: 0.95rem; }
      nav a:hover { color: #e6e8ee; }
    </style>
  </head>
  <body>
    <SiteEffects />
    <main class="relative z-10">
      <nav><a href="/">← Події</a><a href="/rules">Правила</a><a href="/privacy">Конфіденційність</a></nav>
      <h1>Мій профіль</h1>
      <p class="lead">Вітаємо, {escapeHtml(userName)}! Тут ви керуєте своїми даними.</p>

      <ProfileForm client:load name={userName} />

      <h2>Створені події <span class="badge">{created.length}</span></h2>
      {created.length === 0
        ? <p class="empty">Ви ще не створили жодної події.</p>
        : <ul>{created.map((event) => (
            <li>
              <a href={`/events/${escapeHtml(event.id)}`}>{escapeHtml(event.title)}</a>
              {event.visibility === 'private' && <span class="badge">приватна</span>}
              <div class="meta">{escapeHtml(formatKyiv(event.starts_at))} · {escapeHtml(event.places)} місць</div>
            </li>
          ))}</ul>}

      <h2>Події, на які я записався <span class="badge">{attending.length}</span></h2>
      {attending.length === 0
        ? <p class="empty">Ви ще не записувалися на події.</p>
        : <ul>{attending.map((event) => (
            <li>
              <a href={`/events/${escapeHtml(event.id)}`}>{escapeHtml(event.title)}</a>
              <div class="meta">{escapeHtml(formatKyiv(event.starts_at))}</div>
            </li>
          ))}</ul>}
    </main>
  </body>
</html>
