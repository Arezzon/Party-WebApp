---
import '../styles/global.css';
import FlowBackdrop from '../components/site/FlowBackdrop.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { isModerator } from '../lib/moderation';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Тусовка — події',
  description = 'Події, вечірки та зустрічі. Обирай своє.'
} = Astro.props;

const currentUser = (Astro.locals as any).user;
const moderator = Boolean(currentUser && isModerator(currentUser.email));
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('tusivka-theme');
          const dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch {}
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <div class="site-frame site-frame--top" aria-hidden="true"></div>
    <div class="site-frame site-frame--left" aria-hidden="true"></div>
    <div class="site-frame site-frame--right" aria-hidden="true"></div>
    <svg class="site-corner site-corner--tl" width="50" height="50" viewBox="0 0 50 50" fill="none" aria-hidden="true"><path d="M0 0C-.008 37.3 8.996 50.012 50 50H0V0Z" fill="currentColor"/></svg>
    <svg class="site-corner site-corner--tr" width="50" height="50" viewBox="0 0 50 50" fill="none" aria-hidden="true"><path d="M0 0C-.008 37.3 8.996 50.012 50 50H0V0Z" fill="currentColor"/></svg>

    <a class="skip-link" href="#main">До вмісту</a>
    <FlowBackdrop />
    <SiteHeader active={Astro.url.pathname} moderator={moderator} />

    <main id="main" class="relative z-10 mx-auto w-full max-w-[1100px] px-5 pb-24 pt-32 sm:px-10 sm:pt-44">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
