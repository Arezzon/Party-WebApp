---
import '../styles/global.css';
import SiteChrome from '../components/site/SiteChrome';
import Background from '../components/site/Background';
import SiteFooter from '../components/site/SiteFooter';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Тусовка — події',
  description = 'Події, вечірки та зустрічі. Обирай своє.'
} = Astro.props;
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <Background client:load />
    <SiteChrome client:load activeHref={Astro.url.pathname} />
    <div class="relative z-10">
      <main class="mx-auto w-full max-w-5xl px-4 pb-12 pt-10 sm:px-6">
        <slot />
      </main>
      <SiteFooter client:load />
    </div>
  </body>
</html>
