---
import '../styles/global.css';
import SiteNav from '../components/bits/SiteNav';
import FooterBits from '../components/bits/FooterBits';
import SiteEffects from '../components/SiteEffects.astro';
import ClickSpark from '../components/ClickSpark';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Тусовка — події з обмеженими місцями',
  description = 'Створюйте події, записуйтеся на них і спілкуйтеся українською.'
} = Astro.props;
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <SiteEffects />
    <div class="relative z-10">
    <SiteNav
      client:load
      activeHref={Astro.url.pathname}
      links={[
        { label: 'Події', href: '/' },
        { label: 'Створити', href: '/events/new' },
        { label: 'Профіль', href: '/profile' },
        { label: 'Правила', href: '/rules' }
      ]}
    />
    <ClickSpark
      client:load
      sparkColor={['#ff2e88', '#00e5ff', '#fff5fb']}
      sparkSize={8}
      sparkRadius={28}
      sparkCount={8}
      duration={380}
      easing="ease-out"
      ring={false}
      layer="front"
    >
    <main class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
      <slot />
    </main>
    </ClickSpark>
    <FooterBits
      client:load
      links={[
        { label: 'Політика конфіденційності', href: '/privacy', icon: 'shield' },
        { label: 'Правила сервісу', href: '/rules', icon: 'book' }
      ]}
    />
    </div>
  </body>
</html>
