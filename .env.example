# Шлях до SQLite БД (створиться автоматично разом із батьківською папкою)
DATABASE_PATH=./data/tusivka.db

# Обов'язково зміни на випадковий секрет у продакшені:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-32-byte-secret

# Ім'я cookie сесії (за замовчуванням "session")
SESSION_COOKIE_NAME=session

# Термін життя сесії, днів
SESSION_TTL_DAYS=30

# Увімкнути Secure-прапорець cookie (тільки на HTTPS у продакшені)
SECURE_COOKIES=false

# Ліміт завантаження обкладинки, байт (10 MiB за замовчуванням)
MAX_UPLOAD_BYTES=10485760

# Логін: спроб і вікно блокування
MAX_LOGIN_ATTEMPTS=10
LOGIN_WINDOW_MS=60000

# Максимальний горизонт дати події в роках
MAX_EVENT_YEARS=2

# Модератори (email через кому; регістр не враховується)
MODERATOR_EMAILS=arsen@tusivka.local
